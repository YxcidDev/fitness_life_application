        "query": "SELECT\n  ud.user_id,\n  ud.fcm_token,\n  ud.platform\nFROM public.user_devices ud\nWHERE\n  ud.is_active = true\n  AND NOT EXISTS (\n    SELECT 1 FROM public.meals m\n    WHERE\n      m.user_id    = ud.user_id\n      AND m.meal_type   = 'breakfast'\n      AND m.analyzed_at >= CURRENT_DATE\n      AND m.analyzed_at <  CURRENT_DATE + INTERVAL '1 day'\n  );",
